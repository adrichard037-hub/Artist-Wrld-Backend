generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model artistprofile {
  id           String   @id @default(cuid())
  userId       String   @unique(map: "ArtistProfile_userId_key")
  bio          String?  @db.Text
  location     String?
  profileImage String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId], map: "ArtistProfile_userId_idx")
}

model artwork {
  id                String              @id @default(cuid())
  artistId          String
  title             String              @db.VarChar(150)
  category          String              @db.VarChar(80)
  description       String?             @db.Text
  price             Decimal             @db.Decimal(12, 2)
  image             String?             @db.LongText
  status            String              @default("Draft") @db.VarChar(30)
  views             Int                 @default(0)
  sales             Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  buyerwishlistitem buyerwishlistitem[]

  @@index([artistId], map: "Artwork_artistId_idx")
  @@index([status], map: "Artwork_status_idx")
}

model auditlog {
  id        String   @id @default(cuid())
  username  String
  role      String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

model backupsnapshot {
  id        String                   @id @default(cuid())
  ownerId   String
  ownerRole backupsnapshot_ownerRole
  format    String                   @db.VarChar(100)
  payload   Json
  createdAt DateTime                 @default(now())

  @@index([ownerId, createdAt], map: "BackupSnapshot_ownerId_createdAt_idx")
  @@index([ownerRole, createdAt], map: "BackupSnapshot_ownerRole_createdAt_idx")
}

model buyerprofile {
  id           String   @id @default(cuid())
  userId       String   @unique(map: "BuyerProfile_userId_key")
  location     String?
  profileImage String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId], map: "BuyerProfile_userId_idx")
}

model buyerwishlistitem {
  id        String   @id @default(cuid())
  buyerId   String
  artworkId String
  createdAt DateTime @default(now())
  artwork   artwork  @relation(fields: [artworkId], references: [id], map: "BuyerWishlistItem_artworkId_fkey")
  user      user     @relation(fields: [buyerId], references: [id], map: "BuyerWishlistItem_buyerId_fkey")

  @@unique([buyerId, artworkId], map: "BuyerWishlistItem_buyerId_artworkId_key")
  @@index([artworkId], map: "BuyerWishlistItem_artworkId_idx")
  @@index([buyerId], map: "BuyerWishlistItem_buyerId_idx")
}

model configurationsetting {
  id        String   @id @default(cuid())
  key       String   @unique(map: "ConfigurationSetting_key_key")
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model dashboardpreference {
  id        String   @id @default(cuid())
  userId    String
  key       String   @db.VarChar(100)
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key], map: "DashboardPreference_userId_key_key")
  @@index([userId], map: "DashboardPreference_userId_idx")
}

model deleteduseraudit {
  id             String                @id @default(cuid())
  originalUserId String
  username       String
  email          String
  role           deleteduseraudit_role
  deletedAt      DateTime              @default(now())
  deletedBy      String?
  reason         String?
}

model deliveryassignment {
  id             String    @id @default(cuid())
  deliveryManId  String
  orderReference String?
  artworkTitle   String    @db.VarChar(150)
  customerName   String    @db.VarChar(150)
  pickup         String    @db.VarChar(255)
  destination    String    @db.VarChar(255)
  scheduledDate  DateTime?
  status         String    @default("Assigned") @db.VarChar(30)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([deliveryManId], map: "DeliveryAssignment_deliveryManId_idx")
  @@index([orderReference], map: "DeliveryAssignment_orderReference_idx")
  @@index([status], map: "DeliveryAssignment_status_idx")
}

model deliveryprofile {
  id          String   @id @default(cuid())
  userId      String   @unique(map: "DeliveryProfile_userId_key")
  phone       String?
  serviceArea String?
  avatar      String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId], map: "DeliveryProfile_userId_idx")
}

model loginchallenge {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique(map: "LoginChallenge_tokenHash_key")
  rememberMe Boolean  @default(false)
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "LoginChallenge_userId_fkey")

  @@index([expiresAt], map: "LoginChallenge_expiresAt_idx")
  @@index([userId], map: "LoginChallenge_userId_idx")
}

model message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  subject     String    @db.VarChar(200)
  body        String    @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([readAt], map: "Message_readAt_idx")
  @@index([recipientId, createdAt], map: "Message_recipientId_createdAt_idx")
  @@index([senderId, createdAt], map: "Message_senderId_createdAt_idx")
}

model order {
  id              String   @id @default(cuid())
  buyerId         String
  artistId        String
  artworkId       String
  artworkTitle    String   @db.VarChar(150)
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  status          String   @default("PENDING") @db.VarChar(30)
  shippingAddress String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([artistId], map: "Order_artistId_idx")
  @@index([artworkId], map: "Order_artworkId_idx")
  @@index([buyerId], map: "Order_buyerId_idx")
  @@index([createdAt], map: "Order_createdAt_idx")
  @@index([status], map: "Order_status_idx")
}

model session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique(map: "Session_tokenHash_key")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt], map: "Session_expiresAt_idx")
  @@index([userId], map: "Session_userId_idx")
}

model user {
  id                              String              @id @default(cuid())
  fullName                        String
  username                        String              @unique(map: "User_username_key")
  email                           String              @unique(map: "User_email_key")
  passwordHash                    String
  passwordSalt                    String
  role                            user_role           @default(BUYER)
  isActive                        Boolean             @default(true)
  twoFactorEnabled                Boolean             @default(false)
  twoFactorSecret                 String?
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime            @updatedAt
  twoFactorPendingSecret          String?
  registrationComplete            Boolean             @default(false)
  registrationEnrollmentAttempts  Int                 @default(0)
  registrationEnrollmentExpiresAt DateTime?
  registrationEnrollmentTokenHash String?             @unique(map: "User_registrationEnrollmentTokenHash_key")
  artistApprovalStatus            String              @default("PENDING")
  buyerwishlistitem               buyerwishlistitem[]
  loginchallenge                  loginchallenge[]
}

enum backupsnapshot_ownerRole {
  ADMIN
  ARTIST
  BUYER
  DELIVERY_MAN
}

enum deleteduseraudit_role {
  ADMIN
  ARTIST
  BUYER
  DELIVERY_MAN
}

enum user_role {
  ADMIN
  ARTIST
  BUYER
  DELIVERY_MAN
}

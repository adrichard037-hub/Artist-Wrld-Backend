# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Long random strings. Do not change PEPPER after users exist (all passwords would stop working).
PEPPER=
# Base64 of exactly 32 random bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=
PORT=4000
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173
# Optional: lax | strict | none (default: none in production, lax otherwise)
COOKIE_SAMESITE=
# Optional: number of proxies in front of the app (default 1)
TRUST_PROXY_HOPS=1
